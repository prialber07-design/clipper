# Copia a .env y ajusta. El .env NO va a la imagen (esta en .dockerignore).

# Ruta de almacenamiento de datos dentro del contenedor (volumen)
CLIPPER_DATA=/app/clips

# Avisos al movil (ntfy). El topic es la UNICA credencial: cualquiera que lo
# sepa recibe tus avisos y puede mandarte falsos. Genera uno aleatorio y no lo
# publiques en ningun sitio.
CLIPPER_NTFY_ACTIVO=1
CLIPPER_NTFY_TOPIC=cambia-esto-por-algo-aleatorio
CLIPPER_ADJUNTAR_VIDEO=0

# Marca de agua quemada en el video.
CLIPPER_MARCA=@TuCanal

# Modelo de transcripcion.
#   small          -> unica opcion recomendable en CPU sin GPU (~15-20s por clip)
#   large-v3-turbo -> maxima calidad, pero requiere GPU NVIDIA
CLIPPER_MODELO=small
CLIPPER_COMPUTE=int8

# Puerto y credenciales de la galeria web interna
# Obligatoria: el servidor no inicia la galeria sin una clave no vacia.
CLIPPER_WEB_USUARIO=clips
CLIPPER_WEB_CLAVE=
CLIPPER_WEB_PUERTO=8080

# Dominio con DNS apuntando al servidor en EasyPanel.
CLIPPER_DOMINIO=clips.tudominio.com

# Lo que se pone en el aviso del movil para abrir el clip de un toque.
CLIPPER_URL_PUBLICA=https://clips.tudominio.com

# Evaluación editorial con OpenAI. Si está activa, solo publica clips que
# superen la puerta estricta de Luna y los controles locales de calidad.
# La clave solo va en .env del servidor; nunca la subas al repositorio.
OPENAI_API_KEY=
CLIPPER_LLM_ACTIVO=0
CLIPPER_LLM_MODELO=gpt-5.6-luna
