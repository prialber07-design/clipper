# Copia a .env y ajusta. El .env NO va a la imagen (esta en .dockerignore).

# Avisos al movil (ntfy). El topic es la UNICA credencial: cualquiera que lo
# sepa recibe tus avisos y puede mandarte falsos. Genera uno aleatorio y no lo
# publiques en ningun sitio.
CLIPPER_NTFY_ACTIVO=1
CLIPPER_NTFY_TOPIC=cambia-esto-por-algo-aleatorio
CLIPPER_ADJUNTAR_VIDEO=0

# Marca de agua quemada en el video.
CLIPPER_MARCA=@TuCanal

# Modelo de transcripcion.
#   large-v3-turbo -> calidad buena, necesita GPU
#   small          -> unica opcion viable en CPU con varios canales
CLIPPER_MODELO=large-v3-turbo
CLIPPER_COMPUTE=int8

# Imagen a construir: Dockerfile (CPU) o Dockerfile.gpu
CLIPPER_DOCKERFILE=Dockerfile

# --- Galeria web: lo que te permite recoger los clips con el PC apagado ---
# Sin clave la galeria NO arranca, a proposito.
CLIPPER_WEB_USUARIO=clips
CLIPPER_WEB_CLAVE=pon-aqui-una-clave-larga

# Dominio con DNS apuntando al servidor. Caddy saca el certificado solo.
CLIPPER_DOMINIO=clips.tudominio.com

# Lo que se pone en el aviso del movil para abrir el clip de un toque.
CLIPPER_URL_PUBLICA=https://clips.tudominio.com
