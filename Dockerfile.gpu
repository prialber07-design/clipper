# Variante GPU: acelera la cola serial de transcripciones y reduce su latencia.
# Requiere NVIDIA Container Toolkit en el host y arrancar con --gpus all.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip ffmpeg fontconfig ca-certificates tini curl bash \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN python3 -m pip install --no-cache-dir -r requirements.txt \
    && python3 -m pip install --no-cache-dir \
        nvidia-cublas-cu12 nvidia-cudnn-cu12

COPY *.py config.json ./
COPY fonts ./fonts
RUN mkdir -p /usr/local/share/fonts/clipper \
    && cp fonts/*.ttf /usr/local/share/fonts/clipper/ \
    && fc-cache -f

RUN useradd --system --uid 10001 clipper \
    && mkdir -p /app/clips/modelos \
    && chown -R clipper:clipper /app/clips

ENV CLIPPER_DATA=/app/clips \
    HF_HOME=/app/clips/modelos \
    CLIPPER_COMPUTE=float16 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8

USER clipper
VOLUME ["/app/clips"]

ENTRYPOINT ["/usr/bin/tini", "--"]
HEALTHCHECK --interval=2m --timeout=20s --start-period=180s --retries=3 \
    CMD python3 servidor.py --estado 2>&1 | grep -q "vigilante=activo" || exit 1

CMD ["python3", "servidor.py"]
